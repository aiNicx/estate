# Public origin of the brochure, e.g. https://your-domain.com
# Used for absolute links, metadata and the personal links created by `npm run link`.
NEXT_PUBLIC_SITE_URL=

# --- Personal links (required in production) ---
# Long random secret that signs the personal links, e.g. from:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Without it the site is open in development and fully locked in production.
# Changing it invalidates every link already sent.
ACCESS_SECRET=
# Recipients whose link must stop working, as names or slugs separated by commas.
ACCESS_REVOKED=

# --- View notifications (optional) ---
# Push notification when a recipient actually opens the presentation.
# Free with ntfy: install the ntfy app, subscribe to a long, unguessable topic
# and set e.g. https://ntfy.sh/marina-7Qx2vLp9... here.
VIEW_NOTIFY_URL=

# --- Contact ---
# Address shown in the Enquiries section, with pre-filled mailto links.
# Read at build time: rebuild after changing it. Without it the page asks
# readers to reply to the email in which they received the presentation.
CONTACT_EMAIL=

# --- Privacy notice ---
# Data controller identity shown on /privacy, lines separated by "|".
# Example: Mario Rossi | Via Example 1, 84019 Vietri sul Mare (SA) | privacy@example.com
PRIVACY_CONTROLLER=
